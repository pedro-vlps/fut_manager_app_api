# Copie para .env (ignorado pelo Git) e preencha os valores privados.
FUT_MANAGER_APP_NAME=Fut Manager API
FUT_MANAGER_DEBUG=false
FUT_MANAGER_DOCS_ENABLED=false
FUT_MANAGER_DATABASE_HOST=
FUT_MANAGER_DATABASE_PORT=
FUT_MANAGER_DATABASE_NAME=
FUT_MANAGER_DATABASE_USER=
FUT_MANAGER_DATABASE_PASSWORD=
FUT_MANAGER_DATABASE_ECHO=false
FUT_MANAGER_CREATE_SCHEMA_ON_STARTUP=false
FUT_MANAGER_CORS_ORIGINS=[]
# Nome do volume existente, utilizado somente pelo Compose local.
FUT_MANAGER_DATABASE_VOLUME=

# Gere as chaves fora do repositório; nunca use valores de exemplo em produção.
FUT_MANAGER_PERSONAL_DATA_KEYS=[]
FUT_MANAGER_EMAIL_LOOKUP_KEY=
