# Em execução fora do Docker, use "localhost" como host do banco.
FUT_MANAGER_APP_NAME=Fut Manager API
FUT_MANAGER_DEBUG=true
# Documentação: use false em produção. Sem esta variável, fica desativada.
FUT_MANAGER_DOCS_ENABLED=true
FUT_MANAGER_DATABASE_HOST=
FUT_MANAGER_DATABASE_PORT=
FUT_MANAGER_DATABASE_NAME=
FUT_MANAGER_DATABASE_USER=
FUT_MANAGER_DATABASE_PASSWORD=
FUT_MANAGER_DATABASE_ECHO=false

# Deixe `true` apenas em ambientes de desenvolvimento/banco vazio.
FUT_MANAGER_CREATE_SCHEMA_ON_STARTUP=true
